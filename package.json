{
  "name": "worktracs-foundation-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "node server/tracs-api.mjs",
    "api:sqlite": "node --experimental-sqlite server/tracs-api.mjs",
    "api:postgres": "node server/tracs-api.mjs",
    "postgres:up": "docker compose -f docker-compose.postgres.yml up -d",
    "postgres:down": "docker compose -f docker-compose.postgres.yml down",
    "records:import:postgres": "node server/importRecordsToPostgres.mjs",
    "records:import:postgres:sqlite": "node --experimental-sqlite server/importRecordsToPostgres.mjs --source sqlite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "lucide-react": "^1.17.0",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
